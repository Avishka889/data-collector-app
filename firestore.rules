rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Patients collection rules
    match /patients/{patient} {
      // Allow anyone to submit new patient data (unauthenticated)
      allow create: if true;
      
      // Allow reading patient data only for authenticated app sessions
      allow read: if request.auth != null;
      
      // Prevent unauthorized updates or deletions
      allow update, delete: if false;
    }
  }
}

